ENVIRONMENT=local
DEBUG=true
# App role: restricted, subject to row-level security
DATABASE_URL=postgresql+asyncpg://authforge_app:authforge_app@localhost:5432/authforge
# Owner role: used only by Alembic migrations
DATABASE_ADMIN_URL=postgresql+asyncpg://authforge:authforge@localhost:5432/authforge
# Password given to the app role when migrations create it (set this outside local dev)
APP_DB_PASSWORD=authforge_app
REDIS_URL=redis://localhost:6380/0
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
